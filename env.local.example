# Локальные настройки для разработки (ПК/Ноутбук)
# Скопируйте этот файл как .env на КАЖДОМ компьютере

# Django Settings
SECRET_KEY=dev-secret-key-for-local-development-only
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings (PostgreSQL) - ВАШИ ЛОКАЛЬНЫЕ ДАННЫЕ
DB_NAME=logist2_db
DB_USER=arturas
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_HOST=localhost
DB_PORT=5432

# CSRF для локальной разработки
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Email - для локальной разработки используем console backend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# AI Settings — Grok для чата, OpenAI для embeddings/RAG
AI_CHAT_ENABLED=False
XAI_API_KEY=
AI_API_KEY=
OPENAI_API_KEY=
AI_API_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-4.6
AI_ADMIN_MODEL=grok-4.6
AI_MAX_TOKENS=800
AI_ADMIN_MAX_TOKENS=2500
AI_TEMPERATURE=0.2
AI_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
AI_EMBEDDINGS_MODEL=text-embedding-3-small
AI_RAG_INDEX_PATH=
AI_RAG_TOP_K=4
AI_RAG_MAX_AGE_HOURS=24
